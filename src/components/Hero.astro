---
---

<section id="hero-section" class="relative min-h-[95vh] flex items-center justify-center pt-24 pb-16 overflow-hidden">
  <!-- Cinematic Ambient Background Video / Scenic Layer -->
  <div class="absolute inset-0 z-0">
    <!-- Authentic Taiwan High-Resolution Background (Responsive LCP Optimized) -->
    <img
      id="hero-bg-img"
      src="https://plus.unsplash.com/premium_photo-1661951189203-12decb9d7f8e?q=60&w=1600&auto=format&fit=crop"
      srcset="https://plus.unsplash.com/premium_photo-1661951189203-12decb9d7f8e?q=60&w=800&auto=format&fit=crop 800w, https://plus.unsplash.com/premium_photo-1661951189203-12decb9d7f8e?q=60&w=1600&auto=format&fit=crop 1600w"
      sizes="100vw"
      alt="Taipei 101 Skyline"
      width="1600"
      height="900"
      fetchpriority="high"
      decoding="async"
      class="w-full h-full object-cover scale-100 filter brightness-75 contrast-110 origin-center animate-hero-zoom"
    />
    
    <!-- Multi-Layer Depth Scrim Gradients -->
    <div class="absolute inset-0 bg-gradient-to-b from-zinc-950/80 via-zinc-950/40 to-zinc-950"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-transparent via-zinc-950/30 to-zinc-950/90"></div>
    <div class="absolute inset-0 backdrop-blur-[1.5px]"></div>
  </div>

  <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center flex flex-col items-center">
    <!-- VIP Tag Badge -->
    <div data-animate="hero-badge" class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-amber-400/30 bg-amber-950/40 backdrop-blur-md mb-6 shadow-lg shadow-amber-500/10 animate-hero-badge">
      <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
      <span class="text-xs font-semibold tracking-widest uppercase text-amber-300">2026 Private Island Collections</span>
    </div>

    <!-- Monumental Typography (Immediate Paint for Mobile LCP) -->
    <h1 class="text-5xl sm:text-7xl lg:text-8xl font-serif font-medium tracking-tight text-white max-w-4xl leading-[1.1] mb-6">
      <span class="inline-block" data-hero-word>Taiwan</span> 
      <span class="inline-block" data-hero-word>Top</span> 
      <span class="inline-block" data-hero-word>Travel</span><br />
      <span data-animate="hero-title-sub" class="inline-block mt-4 text-2xl sm:text-4xl italic font-light bg-gradient-to-r from-amber-200 via-amber-400 to-yellow-200 bg-clip-text text-transparent">
        Unrivaled Bespoke Luxury
      </span>
    </h1>

    <!-- Editorial Subtitle (Immediate Paint for Mobile LCP) -->
    <p data-animate="hero-subtitle" class="text-base sm:text-lg lg:text-xl text-zinc-300 max-w-2xl font-light leading-relaxed mb-10">
      From private helicopter canyon traverses in Taroko to ancient tea master ceremonies 2,500m above the clouds. Tailored for discerning travelers seeking Formosa’s finest.
    </p>

    <!-- CTAs Cluster -->
    <div data-animate="hero-cta" class="flex flex-col sm:flex-row items-center gap-4 mb-16 animate-hero-cta">
      <a 
        href="#itineraries" 
        class="w-full sm:w-auto px-8 py-3.5 rounded-full text-xs font-semibold uppercase tracking-wider text-zinc-950 bg-gradient-to-r from-amber-400 via-amber-300 to-yellow-200 hover:from-amber-300 hover:to-amber-400 shadow-xl shadow-amber-500/20 transition-all hover:scale-105 active:scale-95 flex items-center justify-center gap-2"
      >
        <span>Explore Top 10 Itineraries</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
        </svg>
      </a>

      <a 
        href="#estimator" 
        class="w-full sm:w-auto px-7 py-3.5 rounded-full text-xs font-semibold uppercase tracking-wider text-zinc-200 glass-panel hover:bg-white/10 hover:text-white transition-all border border-white/10 hover:border-amber-400/40 flex items-center justify-center gap-2"
      >
        <span>Estimate Journey Cost</span>
        <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </a>
    </div>

    <!-- Floating Metric Pillars -->
    <div data-animate="hero-stats" class="grid grid-cols-2 md:grid-cols-4 gap-4 w-full max-w-4xl pt-8 border-t border-white/10 animate-hero-stats">
      <div class="flex flex-col items-center p-3 rounded-2xl glass-panel">
        <span class="text-2xl lg:text-3xl font-serif text-amber-400">10</span>
        <span class="text-[11px] uppercase tracking-wider text-zinc-400 mt-1">2026 Master Circuits</span>
      </div>
      <div class="flex flex-col items-center p-3 rounded-2xl glass-panel">
        <span class="text-2xl lg:text-3xl font-serif text-amber-400">300 <span class="text-xs font-sans">km/h</span></span>
        <span class="text-[11px] uppercase tracking-wider text-zinc-400 mt-1">Private HSR Bullet Rail</span>
      </div>
      <div class="flex flex-col items-center p-3 rounded-2xl glass-panel">
        <span class="text-2xl lg:text-3xl font-serif text-amber-400">100%</span>
        <span class="text-[11px] uppercase tracking-wider text-zinc-400 mt-1">Tailor-Made Curations</span>
      </div>
      <div class="flex flex-col items-center p-3 rounded-2xl glass-panel">
        <span class="text-2xl lg:text-3xl font-serif text-amber-400">24/7</span>
        <span class="text-[11px] uppercase tracking-wider text-zinc-400 mt-1">VIP On-Ground Concierge</span>
      </div>
    </div>
  </div>

  <!-- Scroll Down Indicator -->
  <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1.5 text-zinc-400">
    <span class="text-[10px] uppercase tracking-widest">Scroll To Discover</span>
    <div class="w-4 h-7 rounded-full border border-zinc-600 flex items-start justify-center p-1">
      <div class="w-1 h-2 rounded-full bg-amber-400 animate-bounce"></div>
    </div>
  </div>
</section>
