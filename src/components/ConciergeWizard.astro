---
import { TOP_10_ITINERARIES } from '../data/itineraries';
---

<section id="concierge-wizard" class="py-24 relative overflow-hidden bg-zinc-950">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Header -->
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-amber-400/30 bg-amber-950/30 text-amber-300 text-xs font-semibold uppercase tracking-widest mb-4">
        <span>Bespoke Concierge Booking</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-serif text-white mb-4">
        Plan Your 2026 Taiwan Journey
      </h2>
      <p class="text-zinc-400 text-sm sm:text-base leading-relaxed font-light">
        A 4-step consultative inquiry. Our senior Taiwan specialists will craft your private itinerary and reply within 24 hours.
      </p>
    </div>

    <!-- Wizard Multi-Step Container -->
    <div class="glass-panel rounded-3xl p-6 sm:p-12 border border-white/10 shadow-2xl bg-zinc-900/60 backdrop-blur-xl relative">
      
      <!-- Progress Bar & Step Indicators -->
      <div class="mb-8">
        <div class="flex items-center justify-between text-xs font-semibold uppercase tracking-wider text-zinc-400 mb-3">
          <span id="step-badge" class="text-amber-400">Step 1 of 4: Island Vision</span>
          <span id="step-pct" class="font-mono">25%</span>
        </div>
        <div class="w-full h-1.5 bg-zinc-800 rounded-full overflow-hidden">
          <div id="wizard-progress-bar" class="h-full bg-gradient-to-r from-amber-400 via-amber-300 to-yellow-200 w-[25%] transition-all duration-500 rounded-full"></div>
        </div>
      </div>

      <!-- Glowing Estimate Applied Toast Alert -->
      <div id="estimate-applied-toast" class="hidden mb-8 p-3.5 rounded-2xl bg-gradient-to-r from-amber-950/80 to-zinc-900 border border-amber-400/50 flex items-center justify-between shadow-xl shadow-amber-500/10 animate-pulse">
        <div class="flex items-center gap-3">
          <div class="w-7 h-7 rounded-full bg-amber-400/20 border border-amber-400/40 flex items-center justify-center text-amber-300">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <div>
            <span class="text-xs font-semibold text-white block">Custom Journey Estimate Locked & Applied</span>
            <span id="toast-estimate-details" class="text-[10px] text-amber-300/90 font-mono">7 Days • 2 Guests • Ultra-Luxe Bespoke</span>
          </div>
        </div>
        <span class="text-[10px] uppercase font-semibold tracking-wider text-amber-400 px-2.5 py-1 rounded-full bg-amber-400/10 border border-amber-400/30">
          Step 2 Active
        </span>
      </div>

      <!-- FORM ROOT -->
      <form id="wizard-form" class="relative min-h-[380px]">
        
        <!-- STEP 1: Vision / Itinerary Selection -->
        <div id="step-1" class="wizard-step space-y-6">
          <h3 class="text-xl font-serif text-white">Select Your Preferred 2026 Circuit</h3>
          <p class="text-xs text-zinc-400 font-light">Choose one of our master circuits or request an entirely bespoke traverse.</p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {TOP_10_ITINERARIES.map((item, idx) => (
              <label class="itinerary-radio-label flex items-start gap-3 p-3.5 rounded-2xl glass-panel border border-white/10 hover:border-amber-400/50 cursor-pointer transition-all">
                <input 
                  type="radio" 
                  name="preferred-itinerary" 
                  value={item.title} 
                  checked={idx === 0}
                  class="mt-1 accent-amber-400"
                />
                <div class="flex-1">
                  <div class="flex justify-between items-center">
                    <span class="text-xs font-semibold text-white">{item.title}</span>
                    <span class="text-[10px] text-amber-400 font-mono">{item.duration}d</span>
                  </div>
                  <span class="text-[10px] text-zinc-400 block mt-0.5">{item.subtitle}</span>
                </div>
              </label>
            ))}
            <label class="itinerary-radio-label flex items-start gap-3 p-3.5 rounded-2xl glass-panel border border-white/10 hover:border-amber-400/50 cursor-pointer transition-all">
              <input 
                type="radio" 
                name="preferred-itinerary" 
                value="Custom Bespoke Traverse" 
                class="mt-1 accent-amber-400"
              />
              <div class="flex-1">
                <span class="text-xs font-semibold text-white">Completely Custom Bespoke Traverse</span>
                <span class="text-[10px] text-zinc-400 block mt-0.5">Crafted entirely from scratch around your passions</span>
              </div>
            </label>
          </div>
        </div>

        <!-- STEP 2: Timing, Days & Party -->
        <div id="step-2" class="wizard-step space-y-6 hidden">
          <h3 class="text-xl font-serif text-white">Travel Dates & Party Size</h3>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label class="text-xs uppercase tracking-wider text-zinc-400 font-medium block mb-2">Estimated Travel Period (2026)</label>
              <select id="travel-month" class="w-full p-3.5 rounded-xl bg-zinc-950 border border-white/10 text-xs text-white focus:border-amber-400 focus:outline-none">
                <option value="Spring 2026 (Mar - May)">Spring 2026 (Cherry Blossoms & Mild Weather)</option>
                <option value="Summer 2026 (Jun - Aug)">Summer 2026 (Tropical Surfing & Alpine Peaks)</option>
                <option value="Autumn 2026 (Sep - Nov)" selected>Autumn 2026 (Dry Peak Season & Harvest Teas)</option>
                <option value="Winter 2026 (Dec - Feb)">Winter 2026 (Hot Springs & Festivals)</option>
              </select>
            </div>

            <div>
              <label class="text-xs uppercase tracking-wider text-zinc-400 font-medium block mb-2">Estimated Duration</label>
              <select id="travel-duration" class="w-full p-3.5 rounded-xl bg-zinc-950 border border-white/10 text-xs text-white focus:border-amber-400 focus:outline-none">
                <option value="4-5 Days">4 - 5 Days (Regional Focus)</option>
                <option value="7-8 Days" selected>7 - 8 Days (Classic Island Discovery)</option>
                <option value="10-12 Days">10 - 12 Days (The Grand Formosa Traverse)</option>
                <option value="14+ Days">14+ Days (Comprehensive Odyssey)</option>
              </select>
            </div>

            <div>
              <label class="text-xs uppercase tracking-wider text-zinc-400 font-medium block mb-2">Total Guests</label>
              <select id="travel-party" class="w-full p-3.5 rounded-xl bg-zinc-950 border border-white/10 text-xs text-white focus:border-amber-400 focus:outline-none">
                <option value="Solo (1 Traveler)">Solo (1 Traveler)</option>
                <option value="Couple (2 Travelers)" selected>Couple (2 Travelers)</option>
                <option value="Family (3-4 Guests)">Family (3 - 4 Guests)</option>
                <option value="Private Group (5+ Guests)">Private Group (5+ Guests)</option>
              </select>
            </div>

            <div>
              <label class="text-xs uppercase tracking-wider text-zinc-400 font-medium block mb-2">Luxury Accommodation Tier</label>
              <select id="travel-tier" class="w-full p-3.5 rounded-xl bg-zinc-950 border border-white/10 text-xs text-white focus:border-amber-400 focus:outline-none">
                <option value="Ultra-Luxe Bespoke" selected>Ultra-Luxe Bespoke (Villas & Presidential Suites)</option>
                <option value="Private Signature">Private Signature (5-Star Luxury Stays)</option>
                <option value="Connoisseur Heritage">Connoisseur Heritage (Boutique Historic Manors)</option>
              </select>
            </div>
          </div>
        </div>

        <!-- STEP 3: Curated Bespoke Desires -->
        <div id="step-3" class="wizard-step space-y-6 hidden">
          <h3 class="text-xl font-serif text-white">Select Signature Inclusions</h3>
          <p class="text-xs text-zinc-400 font-light">Indicate which private experiences you wish to incorporate into your journey.</p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {[
              { id: 'driver', title: 'Dedicated Mercedes Maybach Chauffeur', desc: 'Door-to-door private transport across Taiwan' },
              { id: 'michelin', title: 'Guaranteed 3-Star Michelin Tables', desc: 'Pre-reserved chef tables at Le Palais, RAW, JL Studio' },
              { id: 'tea', title: 'Private High-Mountain Tea Master', desc: 'Grand champion cupping session 2,500m in Alishan' },
              { id: 'heli', title: 'Private Taroko Canyon Helicopter Hop', desc: 'Aerial panoramic flyover of vertical marble cliffs' },
              { id: 'yacht', title: 'Sun Moon Lake Electric Yacht Charter', desc: 'Private mahogany boat champagne cruise at dawn' },
              { id: 'guide', title: 'English Art & Heritage Historian Escort', desc: 'Senior scholar accompanying all cultural sites' }
            ].map(item => (
              <label class="flex items-start gap-3 p-3.5 rounded-2xl glass-panel border border-white/10 hover:border-amber-400/50 cursor-pointer transition-all">
                <input type="checkbox" name="inclusions" value={item.title} class="mt-1 accent-amber-400" />
                <div>
                  <span class="text-xs font-semibold text-white block">{item.title}</span>
                  <span class="text-[10px] text-zinc-400 block mt-0.5">{item.desc}</span>
                </div>
              </label>
            ))}
          </div>
        </div>

        <!-- STEP 4: VIP Client Profile -->
        <div id="step-4" class="wizard-step space-y-6 hidden">
          <h3 class="text-xl font-serif text-white">Your VIP Contact Profile</h3>
          <p class="text-xs text-zinc-400 font-light">Where should our senior travel designer send your preliminary proposal?</p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="client-name" class="text-xs uppercase tracking-wider text-zinc-400 font-medium block mb-2">Guest / Principal Name *</label>
              <input type="text" id="client-name" required placeholder="e.g. Alistair Vance" class="w-full p-3.5 rounded-xl bg-zinc-950 border border-white/10 text-xs text-white placeholder-zinc-600 focus:border-amber-400 focus:outline-none" />
            </div>

            <div>
              <label for="client-country" class="text-xs uppercase tracking-wider text-zinc-400 font-medium block mb-2">Country of Residence / Origin</label>
              <input type="text" id="client-country" placeholder="United States / United Kingdom / Singapore" class="w-full p-3.5 rounded-xl bg-zinc-950 border border-white/10 text-xs text-white placeholder-zinc-600 focus:border-amber-400 focus:outline-none" />
            </div>

            <div class="sm:col-span-2">
              <label for="preferred-contact-channel" class="text-xs uppercase tracking-wider text-zinc-400 font-medium block mb-2">Consultation Preference</label>
              <select id="preferred-contact-channel" class="w-full p-3.5 rounded-xl bg-zinc-950 border border-white/10 text-xs text-white focus:border-amber-400 focus:outline-none">
                <option value="Direct Platform Messages" selected>Direct Platform Messaging (Secure Inquiry)</option>
                <option value="In-App Concierge Chat">In-App Concierge Chat Briefing</option>
                <option value="Executive Dossier Transmission">Direct Executive Dossier Transmission</option>
              </select>
            </div>
          </div>

          <div>
            <label for="client-notes" class="text-xs uppercase tracking-wider text-zinc-400 font-medium block mb-2">Special Requests, Dietary & Travel Desires</label>
            <textarea id="client-notes" rows="3" placeholder="Tell us about special dietary preferences, desired pace of travel, or specific landmarks you dream of seeing..." class="w-full p-3.5 rounded-xl bg-zinc-950 border border-white/10 text-xs text-white placeholder-zinc-600 focus:border-amber-400 focus:outline-none"></textarea>
          </div>

          <div class="p-3.5 rounded-xl bg-white/[0.02] border border-white/5 text-[11px] text-zinc-500 leading-relaxed">
            <span class="text-amber-400/90 font-medium uppercase tracking-wider block mb-0.5">Showcase Demonstration:</span>
            Submitting this dossier triggers an interactive portfolio simulation. Inquiries are illustrative and do not initiate commercial contracts or deposit requests.
          </div>
        </div>

        <!-- SUCCESS CONFIRMATION MODAL STATE -->
        <div id="step-success" class="wizard-step space-y-6 text-center py-10 hidden">
          <div class="w-16 h-16 rounded-full bg-amber-400/20 border border-amber-400 flex items-center justify-center mx-auto text-amber-300">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
          </div>

          <h3 class="text-2xl font-serif text-white">Your Bespoke Journey Brief is Received</h3>
          <p class="text-xs sm:text-sm text-zinc-300 max-w-lg mx-auto leading-relaxed">
            Thank you. Your inquiry dossier has been dispatched to our Chief Concierge in Taipei. A customized itinerary proposal will be transmitted to your platform messages within 24 hours.
          </p>

          <div class="inline-block p-4 rounded-2xl glass-panel border border-amber-400/30">
            <span class="text-[10px] uppercase tracking-widest text-zinc-400 block mb-1">VIP Dossier Reference</span>
            <span id="reference-number" class="text-base font-mono font-bold text-amber-300">TW-2026-8942</span>
          </div>

          <p class="text-[11px] text-zinc-500 max-w-md mx-auto pt-2">
            <strong class="text-amber-400/80">Demonstration Notice:</strong> This dossier reference is an interactive simulation generated for portfolio evaluation. No commercial booking contract has been initiated.
          </p>
        </div>

        <!-- Wizard Nav Buttons -->
        <div id="wizard-controls" class="flex items-center justify-between pt-8 border-t border-white/10 mt-8">
          <button 
            type="button" 
            id="wizard-prev-btn" 
            class="px-6 py-2.5 rounded-full text-xs font-semibold uppercase tracking-wider text-zinc-400 hover:text-white glass-panel transition-all disabled:opacity-30 disabled:pointer-events-none"
            disabled
          >
            Previous
          </button>

          <button 
            type="button" 
            id="wizard-next-btn" 
            class="px-8 py-3 rounded-full text-xs font-semibold uppercase tracking-wider text-zinc-950 bg-gradient-to-r from-amber-400 via-amber-300 to-yellow-200 hover:from-amber-300 hover:to-amber-400 transition-all shadow-lg hover:scale-105 active:scale-95"
          >
            Continue
          </button>
        </div>

      </form>

    </div>

  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    let currentStep = 1;
    const totalSteps = 4;

    const stepEl = document.getElementById('step-badge');
    const pctEl = document.getElementById('step-pct');
    const barEl = document.getElementById('wizard-progress-bar');
    const prevBtn = document.getElementById('wizard-prev-btn') as HTMLButtonElement;
    const nextBtn = document.getElementById('wizard-next-btn') as HTMLButtonElement;
    const controls = document.getElementById('wizard-controls');

    const stepTitles = [
      'Step 1 of 4: Island Vision',
      'Step 2 of 4: Travel Dates & Party',
      'Step 3 of 4: Curated Desires',
      'Step 4 of 4: VIP Client Profile'
    ];

    function showStep(step: number) {
      for (let i = 1; i <= totalSteps; i++) {
        const el = document.getElementById(`step-${i}`);
        if (el) el.classList.toggle('hidden', i !== step);
      }

      if (stepEl) stepEl.textContent = stepTitles[step - 1];
      const pct = Math.round((step / totalSteps) * 100);
      if (pctEl) pctEl.textContent = `${pct}%`;
      if (barEl) barEl.style.width = `${pct}%`;

      if (prevBtn) prevBtn.disabled = step === 1;
      if (nextBtn) {
        nextBtn.textContent = step === totalSteps ? 'Dispatch VIP Dossier' : 'Continue';
      }
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        if (currentStep > 1) {
          currentStep--;
          showStep(currentStep);
        }
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        if (currentStep < totalSteps) {
          currentStep++;
          showStep(currentStep);
        } else {
          // Submit form
          const nameInput = document.getElementById('client-name') as HTMLInputElement;

          if (!nameInput?.value) {
            alert('Please provide your name to receive the bespoke itinerary dossier.');
            return;
          }

          // Show success state
          for (let i = 1; i <= totalSteps; i++) {
            document.getElementById(`step-${i}`)?.classList.add('hidden');
          }
          document.getElementById('step-success')?.classList.remove('hidden');
          if (controls) controls.classList.add('hidden');
          if (stepEl) stepEl.textContent = 'Dossier Dispatched';
          if (pctEl) pctEl.textContent = '100%';
          if (barEl) barEl.style.width = '100%';

          const ref = `TW-2026-${Math.floor(1000 + Math.random() * 9000)}`;
          const refEl = document.getElementById('reference-number');
          if (refEl) refEl.textContent = ref;
        }
      });
    }

    // Listen to custom event from Itinerary Cards
    window.addEventListener('tw:preselect-itinerary', (e: any) => {
      const targetName = e.detail?.name;
      if (targetName) {
        const radio = document.querySelector(`input[name="preferred-itinerary"][value="${targetName}"]`) as HTMLInputElement;
        if (radio) radio.checked = true;
      }
    });

    // Listen to custom event from Estimator
    window.addEventListener('tw:transfer-estimate', (e: any) => {
      const { days, party, tier } = e.detail || {};
      const durationSelect = document.getElementById('travel-duration') as HTMLSelectElement;
      const partySelect = document.getElementById('travel-party') as HTMLSelectElement;
      const tierSelect = document.getElementById('travel-tier') as HTMLSelectElement;
      const toast = document.getElementById('estimate-applied-toast');
      const toastDetails = document.getElementById('toast-estimate-details');

      if (durationSelect && days) {
        durationSelect.value = days > 9 ? '10-12 Days' : (days > 6 ? '7-8 Days' : (days >= 4 ? '4-5 Days' : '14+ Days'));
      }
      if (partySelect && party) {
        partySelect.value = party === 1 ? 'Solo (1 Traveler)' : (party === 2 ? 'Couple (2 Travelers)' : (party <= 4 ? 'Family (3-4 Guests)' : 'Private Group (5+ Guests)'));
      }
      if (tierSelect && tier) {
        tierSelect.value = tier;
      }

      // Update toast metadata
      if (toastDetails) {
        toastDetails.textContent = `${days || 7} Days • ${party || 2} Guest${(party || 2) > 1 ? 's' : ''} • ${tier || 'Ultra-Luxe Bespoke'}`;
      }
      if (toast) {
        toast.classList.remove('hidden');
      }

      // Seamless Conversion: Auto-advance to Step 2!
      currentStep = 2;
      showStep(2);

      // Smooth scroll directly to the active wizard
      const wizardSection = document.getElementById('concierge-wizard');
      if (wizardSection) {
        wizardSection.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });
</script>
