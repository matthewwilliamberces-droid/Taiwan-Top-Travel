---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import HorizontalRunway from '../components/HorizontalRunway.astro';
import TransitVisualizer from '../components/TransitVisualizer.astro';
import SeasonalityMatrix from '../components/SeasonalityMatrix.astro';
import TripEstimator from '../components/TripEstimator.astro';
import ConciergeWizard from '../components/ConciergeWizard.astro';
import Footer from '../components/Footer.astro';
import FloatingHud from '../components/FloatingHud.astro';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO & Primary Meta -->
    <title>Taiwan Top Travel — Bespoke Luxury Concierge & 2026 Circuits</title>
    <meta name="description" content="Discover the Top 10 Itineraries in Taiwan for 2026. Private high-speed rail journeys, Alishan tea estates, Taroko marble canyons, and Michelin gastronomy." />
    <meta property="og:title" content="Taiwan Top Travel — Bespoke Luxury Concierge" />
    <meta property="og:description" content="Private luxury circuits across Formosa. 10 curated 2026 itineraries with interactive rail transit, seasonal matrices, and bespoke pricing estimator." />
    <meta property="og:type" content="website" />
    
    <!-- Resource Hints & Responsive LCP Preload -->
    <link rel="preconnect" href="https://plus.unsplash.com" crossorigin />
    <link 
      rel="preload" 
      as="image" 
      href="https://plus.unsplash.com/premium_photo-1661951189203-12decb9d7f8e?q=80&w=800&auto=format&fit=crop" 
      imagesrcset="https://plus.unsplash.com/premium_photo-1661951189203-12decb9d7f8e?q=80&w=800&auto=format&fit=crop 800w, https://plus.unsplash.com/premium_photo-1661951189203-12decb9d7f8e?q=80&w=1600&auto=format&fit=crop 1600w" 
      imagesizes="100vw" 
      fetchpriority="high" 
    />

    <!-- Typography: Scoped Google Fonts with Asynchronous Loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Playfair+Display:ital,wght@0,500;0,700;1,400&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Playfair+Display:ital,wght@0,500;0,700;1,400&display=swap" rel="stylesheet" />
      <style>
        [data-animate], [data-hero-word] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body class="bg-zinc-950 text-zinc-100 antialiased selection:bg-amber-400 selection:text-zinc-950">
    
    <!-- Top Navigation Bar -->
    <Navbar />

    <main>
      <!-- Hero Section with Ambient Video & Anime.js Reveals -->
      <Hero />

      <!-- Pinned Scroll-Driven Horizontal Runway with Safety-Valve Grid Drawer -->
      <HorizontalRunway />

      <!-- High-Speed Rail 300km/h Transit Visualizer -->
      <TransitVisualizer />

      <!-- Seasonality & Climate Rhythm Matrix -->
      <SeasonalityMatrix />

      <!-- Interactive Trip Cost & Style Estimator -->
      <TripEstimator />

      <!-- 4-Step Animated Concierge Wizard -->
      <ConciergeWizard />
    </main>

    <!-- Editorial Footer -->
    <Footer />

    <!-- Floating Ergonomic HUD (Back to Top with Progress Ring & Concierge Trigger) -->
    <FloatingHud />

    <!-- Motion Orchestration -->
    <script>
      import { initHeroAnimation } from '../scripts/animations';

      const runHeroInit = () => {
        if ('requestIdleCallback' in window) {
          (window as any).requestIdleCallback(() => initHeroAnimation('#hero-section'), { timeout: 1200 });
        } else {
          requestAnimationFrame(() => initHeroAnimation('#hero-section'));
        }
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', runHeroInit);
      } else {
        runHeroInit();
      }
      document.addEventListener('astro:page-load', runHeroInit);
    </script>
  </body>
</html>
